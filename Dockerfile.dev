# Aegis-V2X — Development container (Phase 1 baseline image)
# Heavier phase-specific images (CARLA server, Jetson cross-build, etc.)
# are defined separately under deployment/ and simulation/ once those
# phases begin.
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

COPY requirements/base.txt requirements/dev.txt requirements/
RUN pip install --upgrade pip && \
    pip install -r requirements/dev.txt

COPY . .

CMD ["/bin/bash"]
