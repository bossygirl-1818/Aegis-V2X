flowchart TB
    subgraph L1["Layer 1 — Physical Environment"]
        CARLA["CARLA\n(vehicles, roads, weather, sensors)"]
    end
    subgraph L2["Layer 2 — Wireless Environment"]
        SIONNA["NVIDIA Sionna RT\n(CSI, SNR, path loss, blockage)"]
    end
    subgraph L3["Layer 3 — Synchronized Multimodal Inputs"]
        SYNC["LiDAR + GPS + IMU + CSI + SNR + Map/Traffic"]
    end
