        PP["PointPillars"] --> VIT["V2X-ViT"] --> GRU["GRU Predictor"]
    end
    subgraph L5["Layer 5 — Digital Twin State"]
        DT["DigitalTwinState\nCSI, SNR, Beam, Mobility, Env, Uncertainty, Age"]
    end
    subgraph L6["Layer 6 — Digital Twin Self-Evaluation"]
        TRUST["Calibrated Twin Trust Estimator\nT in [0,1]"]
        CRIT["Criticality Estimator\nC in [0,1]"]
    end
    subgraph L7["Layer 7 — TwinTrust-AP"]
        TAHS["TAHS\n(prediction horizon)"]
        FSDP["FSDP\n(joint action, O(1) lookup)"]
    end
    EXEC["Execution Layer\nPrediction Scheduler, DT Synchronizer,\nBeam Manager, Comm Controller"]
    FEEDBACK["Runtime Feedback"]

    CARLA --> SIONNA --> SYNC --> PP
    GRU --> DT
    DT --> TRUST
    DT --> CRIT
    TRUST --> TAHS
    TRUST --> FSDP
